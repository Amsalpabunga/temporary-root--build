+    private static boolean isAarch64PieExecutable(File file) {
+        try (RandomAccessFile raf = new RandomAccessFile(file, "r")) {
+            if (raf.length() < 64) return false;
+            byte[] header = new byte[64];
+            raf.readFully(header);
+            if (header[0] != 0x7f || header[1] != 'E'
+                    || header[2] != 'L' || header[3] != 'F') return false;
+            if ((header[4] & 0xff) != 2 || (header[5] & 0xff) != 1) return false;
+            if (u16le(header, 16) != 3 || u16le(header, 18) != 183) return false;
+            if (u64le(header, 24) == 0) return false;
+
+            long phoff = u64le(header, 32);
+            int phentsize = u16le(header, 54);
+            int phnum = u16le(header, 56);
+            if (phoff < 64 || phentsize < 56 || phnum == 0 || phnum > 256
+                    || phoff + (long) phentsize * phnum > raf.length()) return false;
+
+            byte[] phdr = new byte[phentsize];
+            boolean executableLoadSegment = false;
+            for (int i = 0; i < phnum; i++) {
+                raf.seek(phoff + (long) i * phentsize);
+                raf.readFully(phdr);
+                long type = u32le(phdr, 0);
+                long flags = u32le(phdr, 4);
+                // PT_LOAD with PF_X: proves this PIE contains executable code.
+                if (type == 1 && (flags & 1) != 0) {
+                    executableLoadSegment = true;
+                    break;
+                }
+            }
+            return executableLoadSegment;
+        } catch (IOException | RuntimeException ignored) {
+            return false;
+        }
