+    private static final long MIN_RANDOM_KSUD_SIZE = 1024L * 1024L;
+
+    /**
+     * Resolve the manager's ksud payload.
+     *
+     * Legacy managers keep their stable names. Newer SukiSU builds may package
+     * the PIE executable under a generated .so name; for those, accept only a
+     * single >1 MiB ELF64 little-endian AArch64 ET_DYN file with a non-zero
+     * entry point and an executable PT_LOAD segment. Ambiguous directories fail
+     * closed instead of selecting an arbitrary large native library.
+     */
+    static File findKsud(ApplicationInfo app) {
+        if (app == null || app.nativeLibraryDir == null) return null;
+        File dir = new File(app.nativeLibraryDir);
+
+        // Preserve compatibility with managers that use the documented names.
+        File named = new File(dir, "libksud.so");
+        if (isReadableFile(named)) return named;
+        named = new File(dir, "ksud");
+        if (isReadableFile(named)) return named;
+
+        File[] files = dir.listFiles();
+        if (files == null) return null;
+        List<File> candidates = new ArrayList<>();
+        for (File file : files) {
+            if (!file.getName().endsWith(".so")
+                    || !isReadableFile(file)
+                    || file.length() <= MIN_RANDOM_KSUD_SIZE) {
+                continue;
+            }
+            if (isAarch64PieExecutable(file)) candidates.add(file);
+        }
+        return candidates.size() == 1 ? candidates.get(0) : null;
+    }
